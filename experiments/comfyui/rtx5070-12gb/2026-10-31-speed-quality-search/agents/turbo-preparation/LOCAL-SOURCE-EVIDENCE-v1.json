      "excerpts": [
        {
          "line": 338,
          "text": "class ModelSamplingAV(ModelSamplingDiscreteFlow):"
        },
        {
          "line": 339,
          "text": "    \"\"\"Flow sampling for packed audio-video latents whose audio stream has its own flow shift."
        },
        {
          "line": 340,
          "text": ""
        },
        {
          "line": 341,
          "text": "    Carrying the audio latent scaled onto the video schedule makes the pack an ordinary"
        },
        {
          "line": 342,
          "text": "    single-schedule flow latent whose audio target is scaled by audio_scale."
        },
        {
          "line": 343,
          "text": "    \"\"\""
        },
        {
          "line": 344,
          "text": "    def __init__(self, model_config=None):"
        },
        {
          "line": 345,
          "text": "        super().__init__(model_config)"
        },
        {
          "line": 346,
          "text": "        sampling_settings = model_config.sampling_settings if model_config is not None else {}"
        },
        {
          "line": 347,
          "text": "        self.audio_shift = sampling_settings.get(\"audio_shift\", None)"
        },
        {
          "line": 348,
          "text": ""
        },
        {
          "line": 349,
          "text": "    def set_parameters(self, shift=1.0, audio_shift=None, timesteps=1000, multiplier=1000):"
        },
        {
          "line": 350,
          "text": "        self.audio_shift = audio_shift"
        },
        {
          "line": 351,
          "text": "        super().set_parameters(shift=shift, timesteps=timesteps, multiplier=multiplier)"
        },
        {
          "line": 352,
          "text": ""
        },
        {
          "line": 353,
          "text": "    @property"
        },
        {
          "line": 354,
          "text": "    def audio_scale(self):"
        },
        {
          "line": 355,
          "text": "        if self.audio_shift is None:"
        },
        {
          "line": 356,
          "text": "            return 1.0"
        },
        {
          "line": 357,
          "text": "        return self.shift / self.audio_shift"
        }
      ]
    },
    {
      "path": "comfy/ops.py",
      "sha256": "0167aef2929b92ba3623376f7656e58ead5869485b926b09bead525f32e4dd06",
