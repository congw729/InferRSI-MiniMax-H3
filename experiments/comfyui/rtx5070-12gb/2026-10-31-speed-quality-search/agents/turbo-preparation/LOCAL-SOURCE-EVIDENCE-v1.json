        {
          "line": 177,
          "text": "    def inject(self):"
        },
        {
          "line": 178,
          "text": "        \"\"\"Replace module forward with bypass version.\"\"\""
        },
        {
          "line": 179,
          "text": "        if self.original_forward is not None:"
        },
        {
          "line": 180,
          "text": "            logging.debug("
        },
        {
          "line": 181,
          "text": "                f\"[BypassHook] Already injected for {type(self.module).__name__}\""
        },
        {
          "line": 182,
          "text": "            )"
        },
        {
          "line": 183,
          "text": "            return  # Already injected"
        },
        {
          "line": 184,
          "text": ""
        },
        {
          "line": 185,
          "text": "        # Move adapter weights to compute device (GPU)"
        },
        {
          "line": 186,
          "text": "        # Use get_torch_device() instead of module.weight.device because"
        },
        {
          "line": 187,
          "text": "        # with offloading, module weights may be on CPU while compute happens on GPU"
        },
        {
          "line": 188,
          "text": "        device = comfy.model_management.get_torch_device()"
        },
        {
          "line": 189,
          "text": ""
        },
        {
          "line": 190,
          "text": "        # Get dtype from module weight if available"
        },
        {
          "line": 191,
          "text": "        dtype = None"
        },
        {
          "line": 192,
          "text": "        if hasattr(self.module, \"weight\") and self.module.weight is not None:"
        },
        {
          "line": 193,
          "text": "            dtype = self.module.weight.dtype"
        },
        {
          "line": 194,
          "text": ""
        },
        {
          "line": 195,
          "text": "        # Only use dtype if it's a standard float type, not quantized"
        },
        {
          "line": 196,
          "text": "        if dtype is not None and dtype not in (torch.float32, torch.float16, torch.bfloat16):"
        },
        {
          "line": 197,
          "text": "            dtype = None"
        },
        {
          "line": 198,
          "text": ""
        },
        {
          "line": 199,
          "text": "        self._move_adapter_weights_to_device(device, dtype)"
        },
        {
          "line": 200,
          "text": ""
        },
        {
          "line": 201,
          "text": "        self.original_forward = self.module.forward"
        },
        {
          "line": 202,
          "text": "        self.original_force_forward = getattr(self.module, \"comfy_force_forward\", False)"
        },
        {
          "line": 203,
          "text": "        self.module.comfy_force_forward = True"
        },
        {
          "line": 204,
          "text": "        self.module.forward = self._bypass_forward"
        },
        {
          "line": 227,
          "text": "        # WeightAdapterBase: handle self.weights tuple"
        },
        {
          "line": 228,
          "text": "        if not hasattr(adapter, \"weights\") or adapter.weights is None:"
        },
        {
          "line": 229,
          "text": "            return"
        },
        {
          "line": 230,
          "text": ""
        },
        {
          "line": 231,
          "text": "        weights = adapter.weights"
        },
        {
          "line": 232,
          "text": "        if isinstance(weights, (list, tuple)):"
        },
        {
          "line": 233,
          "text": "            new_weights = []"
        },
        {
          "line": 234,
          "text": "            for w in weights:"
        },
        {
          "line": 235,
          "text": "                if isinstance(w, torch.Tensor):"
        },
        {
          "line": 236,
          "text": "                    if dtype is not None:"
        },
        {
          "line": 237,
          "text": "                        new_weights.append(w.to(device=device, dtype=dtype))"
        },
        {
          "line": 238,
          "text": "                    else:"
        },
        {
          "line": 239,
          "text": "                        new_weights.append(w.to(device=device))"
        },
        {
          "line": 240,
          "text": "                else:"
        },
        {
          "line": 375,
          "text": "            hook = BypassForwardHook(module, adapter, multiplier=strength)"
        },
        {
          "line": 376,
          "text": "            self.hooks.append(hook)"
        },
        {
          "line": 377,
          "text": ""
        },
        {
          "line": 378,
          "text": "        logging.debug(f\"[BypassManager] Created {len(self.hooks)} hooks\")"
        },
        {
          "line": 379,
          "text": ""
        },
        {
          "line": 380,
          "text": "        # Create single injection that manages all hooks"
        },
        {
          "line": 381,
          "text": "        def inject_all(model_patcher):"
        },
        {
          "line": 382,
          "text": "            logging.debug("
        },
        {
          "line": 383,
          "text": "                f\"[BypassManager] inject_all called, injecting {len(self.hooks)} hooks\""
        },
        {
          "line": 384,
          "text": "            )"
        },
        {
          "line": 385,
          "text": "            for hook in self.hooks:"
        },
        {
          "line": 386,
          "text": "                hook.inject()"
        },
        {
          "line": 387,
          "text": "                logging.debug("
        },
        {
          "line": 388,
          "text": "                    f\"[BypassManager] Injected hook for {type(hook.module).__name__}\""
        },
        {
          "line": 389,
          "text": "                )"
        },
        {
          "line": 390,
          "text": ""
        },
        {
          "line": 391,
          "text": "        def eject_all(model_patcher):"
        },
        {
          "line": 392,
          "text": "            logging.debug("
        },
        {
          "line": 393,
          "text": "                f\"[BypassManager] eject_all called, ejecting {len(self.hooks)} hooks\""
        },
        {
          "line": 394,
          "text": "            )"
        },
        {
          "line": 395,
          "text": "            for hook in self.hooks:"
        },
        {
          "line": 396,
          "text": "                hook.eject()"
        },
        {
          "line": 397,
          "text": ""
        },
        {
          "line": 398,
          "text": "        return [PatcherInjection(inject=inject_all, eject=eject_all)]"
        }
      ]
