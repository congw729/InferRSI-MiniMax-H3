      "excerpts": [
        {
          "line": 316,
          "text": "    def post_cast(s, param_key, x, dtype, resident, update_weight):"
        },
        {
          "line": 317,
          "text": "        lowvram_fn = getattr(s, param_key + \"_lowvram_function\", None)"
        },
        {
          "line": 318,
          "text": "        fns = getattr(s, param_key + \"_function\", [])"
        },
        {
          "line": 319,
          "text": ""
        },
        {
          "line": 320,
          "text": "        if x is None:"
        },
        {
          "line": 321,
          "text": "            return None"
        },
        {
          "line": 322,
          "text": ""
        },
        {
          "line": 323,
          "text": "        orig = x"
        },
        {
          "line": 324,
          "text": ""
        },
        {
          "line": 325,
          "text": "        def to_dequant(tensor, dtype):"
        },
        {
          "line": 326,
          "text": "            tensor = tensor.to(dtype=dtype)"
        },
        {
          "line": 327,
          "text": "            if isinstance(tensor, QuantizedTensor):"
        },
        {
          "line": 328,
          "text": "                tensor = tensor.dequantize()"
        },
        {
          "line": 329,
          "text": "            return tensor"
        },
        {
          "line": 330,
          "text": ""
        },
        {
          "line": 331,
          "text": "        if (return_weights and orig.dtype != dtype) or len(fns) > 0:"
        },
        {
          "line": 332,
          "text": "            x = to_dequant(x, dtype)"
        },
        {
          "line": 333,
          "text": "        if not resident and lowvram_fn is not None:"
        },
        {
          "line": 334,
          "text": "            x = to_dequant(x, dtype if compute_dtype is None else compute_dtype)"
        },
        {
          "line": 335,
          "text": "            x = lowvram_fn(x)"
        },
        {
          "line": 336,
          "text": "            if (want_requant and len(fns) == 0 or update_weight):"
        },
        {
          "line": 337,
          "text": "                seed = comfy.utils.string_to_seed(s.seed_key)"
        },
        {
          "line": 338,
          "text": "                if isinstance(orig, QuantizedTensor):"
        },
        {
          "line": 339,
          "text": "                    y = orig.requantize_from_float(x, scale=\"recalculate\", stochastic_rounding=seed)"
        },
        {
          "line": 340,
          "text": "                else:"
        },
        {
          "line": 341,
          "text": "                    y = comfy.float.stochastic_rounding(x, orig.dtype, seed=seed)"
        },
        {
          "line": 342,
          "text": "            if want_requant and len(fns) == 0:"
        },
        {
          "line": 343,
          "text": "                x = y"
        },
        {
          "line": 344,
          "text": "            if update_weight:"
        },
        {
          "line": 345,
          "text": "                orig.copy_(y)"
        },
        {
          "line": 1081,
          "text": "def linear_input_act(linear, x, input_act, act_weight=None, act_eps=0.0,"
        },
        {
          "line": 1082,
          "text": "                     residual=None, residual_scale=None):"
        },
        {
          "line": 1083,
          "text": "    run_every_op()"
        },
        {
          "line": 1084,
          "text": "    weight = linear.weight"
        },
        {
          "line": 1085,
          "text": "    quantized = isinstance(weight, QuantizedTensor)"
        },
        {
          "line": 1086,
          "text": "    if (comfy.model_management.in_training or getattr(linear, \"comfy_force_forward\", False) or getattr(linear, \"_full_precision_mm\", False)"
        },
        {
          "line": 1087,
          "text": "            or not (quantized or _fp16_linear_wanted(x))):"
        },
        {
          "line": 1088,
          "text": "        out = linear(_eager_input_act(x, input_act, act_weight, act_eps))"
        },
        {
          "line": 1089,
          "text": "        return _linear_residual(out, residual, residual_scale)"
        },
        {
          "line": 1090,
          "text": ""
        },
        {
          "line": 1091,
          "text": "    with CastBiasWeightContext(linear, x, offloadable=True,"
        },
        {
          "line": 1092,
          "text": "                               compute_dtype=x.dtype if quantized else None,"
        },
        {
          "line": 1093,
          "text": "                               want_requant=quantized) as (weight, bias):"
        },
        {
          "line": 1094,
          "text": "        if not quantized:"
        },
        {
          "line": 1095,
          "text": "            return linear_input_act_(x, weight, bias, input_act, act_weight, act_eps,"
        },
        {
          "line": 1096,
          "text": "                                     residual, residual_scale)"
        },
        {
          "line": 1097,
          "text": "        out = _try_quantized_linear_input_act(x, weight, bias, input_act, act_weight, act_eps,"
        },
        {
          "line": 1098,
          "text": "                                              residual, residual_scale)"
        },
        {
          "line": 1099,
          "text": "        if out is not NotImplemented:"
        },
        {
          "line": 1100,
          "text": "            return out"
        },
        {
          "line": 1101,
          "text": ""
        },
        {
          "line": 1102,
          "text": "    # A tensor-level fallback cannot replace module-owned input processing."
        },
        {
          "line": 1103,
          "text": "    out = linear(_eager_input_act(x, input_act, act_weight, act_eps))"
        },
        {
          "line": 1104,
          "text": "    return _linear_residual(out, residual, residual_scale)"
        }
      ]
    },
