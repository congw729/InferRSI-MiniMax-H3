      "excerpts": [
        {
          "line": 190,
          "text": "def sample_euler(model, x, sigmas, extra_args=None, callback=None, disable=None, s_churn=0., s_tmin=0., s_tmax=float('inf'), s_noise=1.):"
        },
        {
          "line": 191,
          "text": "    \"\"\"Implements Algorithm 2 (Euler steps) from Karras et al. (2022).\"\"\""
        },
        {
          "line": 192,
          "text": "    extra_args = {} if extra_args is None else extra_args"
        },
        {
          "line": 193,
          "text": "    s_in = x.new_ones([x.shape[0]])"
        },
        {
          "line": 194,
          "text": "    for i in trange(len(sigmas) - 1, disable=disable):"
        },
        {
          "line": 195,
          "text": "        if s_churn > 0:"
        },
        {
          "line": 196,
          "text": "            gamma = min(s_churn / (len(sigmas) - 1), 2 ** 0.5 - 1) if s_tmin <= sigmas[i] <= s_tmax else 0."
        },
        {
          "line": 197,
          "text": "            sigma_hat = sigmas[i] * (gamma + 1)"
        },
        {
          "line": 198,
          "text": "        else:"
        },
        {
          "line": 199,
          "text": "            gamma = 0"
        },
        {
          "line": 200,
          "text": "            sigma_hat = sigmas[i]"
        },
        {
          "line": 201,
          "text": ""
        },
        {
          "line": 202,
          "text": "        if gamma > 0:"
        },
        {
          "line": 203,
          "text": "            eps = torch.randn_like(x) * s_noise"
        },
        {
          "line": 204,
          "text": "            x = x + eps * (sigma_hat ** 2 - sigmas[i] ** 2) ** 0.5"
        },
        {
          "line": 205,
          "text": "        denoised = model(x, sigma_hat * s_in, **extra_args)"
        },
        {
          "line": 206,
          "text": "        d = to_d(x, sigma_hat, denoised)"
        },
        {
          "line": 207,
          "text": "        if callback is not None:"
        },
        {
          "line": 208,
          "text": "            callback({'x': x, 'i': i, 'sigma': sigmas[i], 'sigma_hat': sigma_hat, 'denoised': denoised})"
        },
        {
          "line": 209,
          "text": "        dt = sigmas[i + 1] - sigma_hat"
        },
        {
          "line": 210,
          "text": "        # Euler method"
        },
        {
          "line": 211,
          "text": "        x = x + d * dt"
        },
        {
          "line": 212,
          "text": "    return x"
        },
