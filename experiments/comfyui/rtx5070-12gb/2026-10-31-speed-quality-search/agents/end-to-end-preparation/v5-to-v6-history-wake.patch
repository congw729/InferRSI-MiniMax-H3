+def wait_history_once(done, timeout, used):
+    """One notification wake per request; a consumed event cannot cause busy polling."""
+    if used:
+        time.sleep(timeout)
+        return True, False
+    woke = bool(done.wait(timeout=timeout))
+    return woke, woke
 
 
