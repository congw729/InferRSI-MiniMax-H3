+def verify_hybrid_sources(root, lab_root):
+    root, lab_root = Path(root), Path(lab_root)
+    require(root == lab_root / HYBRID_RELATIVE and root.drive.upper() == "E:"
+            and root.is_dir() and root.resolve() == root, "fixed E hybrid deployment boundary")
+    entries = list(root.rglob("*"))
+    require(len(entries) <= 8, "hybrid deployment entry bound")
+    for path in [root, *entries]:
+        st = path.lstat()
+        require(not path.is_symlink() and not (getattr(st, "st_file_attributes", 0) & 0x400),
+                "hybrid source link/reparse forbidden")
+    actual = {path.relative_to(root).as_posix() for path in entries if path.is_file()}
+    require(actual == set(HYBRID_FILES), "hybrid source file set")
+    records = []
+    for rel, expected in HYBRID_FILES.items():
+        path = root / rel
+        before = path.stat()
+        require(before.st_size == expected["bytes"] and digest(path) == expected["sha256"],
+                "hybrid source identity drift")
+        after = path.stat()
+        require((before.st_size,before.st_mtime_ns,before.st_ino) ==
+                (after.st_size,after.st_mtime_ns,after.st_ino), "hybrid source changed while hashing")
+        records.append({"relative_to_hybrid_root":rel, **expected})
+    return {"files":records, "author_source_unmodified":True,
+            "egrid_present":False, "no_weight_download_code_in_pinned_author_node":True}
+
+def parse_hybrid_application_log(raw):
+    require(type(raw) is bytes and len(raw) <= 4*1024*1024, "bounded hybrid application log")
+    lines = [x for x in raw.splitlines() if x.startswith(b"[MiniMaxH3TurboLoRA]")]
+    require(len(lines) == 1, "one hybrid application log required")
+    expression = (rb"^\[MiniMaxH3TurboLoRA\] full base \[bypass\]: lora="
+                  + re.escape(TURBO_FILENAME.encode())
+                  + rb" strength=1\.0 \| (\d+) backbone modules, (\d+) bypass adapters, "
+                  + rb"(\d+) injections, (\d+) int8 fc2 via merge \| ")
+    match = re.match(expression, lines[0])
+    require(match is not None, "full-base author hybrid log required")
+    total,bypass,injections,merge = map(int,match.groups())
+    require((total,bypass,merge) == (259,209,50) and injections > 0,
+            "hybrid applied-target count differs from pinned full-base plan")
+    return {"total_targets":total,"bypass_targets":bypass,"merge_targets":merge,
+            "injections":injections,"mode":"full_author_hybrid", "source":"author_log",
+            "limit":"Reported application counts, not numerical or perceptual quality proof"}
+
+def verify_hybrid_application_log(path):
+    require(path.is_file() and path.stat().st_size <= 4*1024*1024, "hybrid log size bound")
+    with path.open("rb") as stream:
+        raw = stream.read(4*1024*1024+1)
+    return parse_hybrid_application_log(raw)
 
 
